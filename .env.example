# Google Client ID from Google Cloud Console
EXPO_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here

# Backend API URL
# Use http://10.0.2.2:5184 for Android Emulator
# Use http://localhost:5184 for Web/iOS Simulator
EXPO_PUBLIC_API_URL=http://10.0.2.2:5184

# Set to "true" to use mock data (no real API calls), "false" to use real Axios calls
EXPO_PUBLIC_USE_MOCK=true
